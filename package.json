{
  "name": "academic-pages",
  "version": "0.8.1.1",
  "description": "Academic Pages Mistakes Jekyll theme npm build scripts",
  "repository": {
    "type": "git",
    "url": "https://github.com/academicpages/academicpages.github.io"
  },
  "keywords": [
    "jekyll",
    "theme",
    "minimal"
  ],
  "contributors": [
    "Michael Rose",
    "Robert Zupko"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/academicpages/academicpages.github.io/issues"
  },
  "homepage": "https://github.com/academicpages/academicpages.github.io",
  "engines": {
    "node": ">= 0.10.0"
  },
  "dependencies": {
    "jquery": "^3.7.1"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.4.2",
    "liquidjs": "^10.30.0",
    "node-html-parser": "^9.0.4",
    "onchange": "^7.1.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "uglify-js": "^3.19.3"
  },
  "scripts": {
    "uglify": "uglifyjs node_modules/jquery/dist/jquery.min.js assets/js/plugins/jquery.greedy-navigation.js assets/js/_main.js assets/js/theme.js -c -m -o assets/js/main.min.js",
    "watch:js": "onchange \"assets/js/**/*.js\" -e \"assets/js/main.min.js\" -- npm run build:js",
    "build:js": "npm run uglify",
    "fonts": "node tools/subset-fonts.js",
    "validate": "node tools/validate.mjs",
    "validate:strict": "node tools/validate.mjs --strict",
    "build:content": "node tools/render-content.mjs",
    "check:content": "node tools/render-content.mjs --check --warn",
    "capture:reference": "node tools/capture-reference.mjs",
    "check:structure": "node tools/check-structure.mjs",
    "screenshots": "node tools/screenshots.mjs",
    "test": "node --test \"**/*.test.mjs\"",
    "check": "npm run validate && npm run check:content && npm run check:structure && npm test"
  }
}
