{
  "name": "academic-pages",
  "version": "0.8.1.1",
  "description": "Academic Pages Mistakes Jekyll theme npm build scripts",
  "repository": {
    "type": "git",
    "url": "https://github.com/academicpages/academicpages.github.io"
  },
  "keywords": [
    "jekyll",
    "theme",
    "minimal"
  ],
  "contributors": [
    "Michael Rose",
    "Robert Zupko"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/academicpages/academicpages.github.io/issues"
  },
  "homepage": "https://github.com/academicpages/academicpages.github.io",
  "engines": {
    "node": ">= 20"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.4.2",
    "lighthouse": "^13.5.0",
    "liquidjs": "^10.30.0",
    "node-html-parser": "^9.0.4",
    "onchange": "^7.1.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "uglify-js": "^3.19.3",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "uglify": "uglifyjs assets/js/plugins/jquery.greedy-navigation.js assets/js/_main.js assets/js/theme.js -c -m -o assets/js/main.min.js",
    "uglify:vivus": "uglifyjs assets/js/vivus.js -c -m --comments -o assets/js/vivus.min.js",
    "uglify:han": "uglifyjs assets/js/han.js -c -m -o assets/js/han.min.js",
    "uglify:n404": "uglifyjs assets/js/n404.js -c -m -o assets/js/n404.min.js",
    "watch:js": "onchange \"assets/js/**/*.js\" -e \"assets/js/*.min.js\" -- npm run build:js",
    "build:js": "npm run uglify && npm run uglify:vivus && npm run uglify:han && npm run uglify:n404",
    "fonts": "node tools/subset-fonts.mjs",
    "validate": "node tools/validate.mjs",
    "validate:strict": "node tools/validate.mjs --strict",
    "build:content": "node tools/render-content.mjs && node tools/render-en.mjs",
    "check:content": "node tools/render-content.mjs --check --warn && node tools/render-en.mjs --check --warn",
    "translate:en": "node tools/translate-en.mjs",
    "check:translate": "node tools/translate-en.mjs --check --soft",
    "check:icons": "node tools/subset-fonts.mjs --audit",
    "capture:reference": "node tools/capture-reference.mjs",
    "check:structure": "node tools/check-structure.mjs",
    "lint": "eslint .",
    "check:types": "tsc --noEmit",
    "check:lh": "node tools/check-lh.mjs",
    "check:min-sync": "node tools/check-min-sync.mjs",
    "check:inline-js": "node tools/check-inline-js.mjs",
    "check:404": "node tools/check-404.mjs",
    "check:pwa": "node tools/check-pwa.mjs",
    "rescue:push": "node tools/rescue-push.mjs",
    "ci:poll": "node tools/ci-poll.mjs",
    "check:en": "node tools/check-en-sync.mjs",
    "check:links": "node tools/check-links.mjs",
    "check:behavior": "node tools/check-dom-behavior.mjs",
    "avatar": "node tools/make-avatar.mjs",
    "screenshots": "node tools/screenshots.mjs",
    "test": "node --test \"**/*.test.mjs\"",
    "check": "npm run validate && npm run check:content && npm run check:structure && npm run lint && npm run check:types && npm test"
  }
}
