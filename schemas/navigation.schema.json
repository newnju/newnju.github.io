{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "navigation.schema.json",
  "title": "顶部导航",
  "description": "_data/navigation.yml —— 中英导航共用，英文页优先取 title_en。",
  "type": "object",
  "additionalProperties": false,
  "required": ["main"],
  "properties": {
    "main": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "title_en", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "title_en": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^/[a-z0-9/._-]*$" }
        }
      }
    }
  }
}
