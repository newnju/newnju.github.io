{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "profile.schema.json",
  "title": "个人结构化数据",
  "description": "_data/profile.yml —— 教育背景 / 工作与任职 / 联系方式的唯一数据源。中英同条目用 text/text_en 成对维护，英文页优先取 *_en、缺省回落中文（缺 *_en 会告警但不报错）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contact", "education", "work"],
  "properties": {
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email", "location", "location_en"],
      "properties": {
        "email": { "type": "string", "format": "email" },
        "location": { "type": "string", "minLength": 1 },
        "location_en": { "type": "string", "minLength": 1 }
      }
    },
    "education": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/entry" }
    },
    "work": {
      "type": "array",
      "items": { "$ref": "#/definitions/entry" }
    }
  },
  "definitions": {
    "period": {
      "description": "履历分期：phd 博士 / gap 过渡期 / master 硕士 / bachelor 本科。",
      "type": "string",
      "enum": ["phd", "gap", "master", "bachelor"]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period", "text", "text_en", "daterange", "daterange_en"],
      "properties": {
        "period": { "$ref": "#/definitions/period" },
        "text": { "type": "string", "minLength": 1 },
        "text_en": { "type": "string", "minLength": 1 },
        "daterange": {
          "description": "履历与关于页显示的日期跨度，如 2026.09 – 至今。日期只写在这里，不要写进 text。",
          "type": "string",
          "minLength": 1
        },
        "daterange_en": { "type": "string", "minLength": 1 },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "notes_en": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
