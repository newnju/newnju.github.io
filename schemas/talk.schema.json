{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "talk.schema.json",
  "title": "会议 / 暑校条目",
  "description": "_talks/*.md 的 front matter。",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "title_en", "collection", "type", "type_en", "permalink", "venue", "venue_en", "location", "location_en"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "title_en": { "type": "string", "minLength": 1 },
    "collection": { "const": "talks" },
    "type": { "type": "string", "minLength": 1 },
    "type_en": { "type": "string", "minLength": 1 },
    "permalink": { "type": "string", "pattern": "^/talks/[a-z0-9][a-z0-9-]*/?$" },
    "venue": { "type": "string", "minLength": 1 },
    "venue_en": { "type": "string", "minLength": 1 },
    "location": { "type": "string", "minLength": 1 },
    "location_en": { "type": "string", "minLength": 1 },
    "datetext": {
      "description": "页面上显示的时间文字，如 2025.11；留空则不显示。不是日期，不受 YYYY-MM-DD 限制。",
      "type": "string"
    },
    "excerpt": { "type": "string" },
    "excerpt_en": { "type": "string" }
  }
}
