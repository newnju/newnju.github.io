{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "portfolio.schema.json",
  "title": "项目条目",
  "description": "_portfolio/*.md 的 front matter。period 决定它进履历哪段时期块。",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "title_en", "excerpt", "collection", "date", "daterange", "period", "permalink"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "title_en": { "type": "string", "minLength": 1 },
    "excerpt": { "type": "string", "minLength": 1 },
    "excerpt_en": { "type": "string", "minLength": 1 },
    "collection": { "const": "portfolio" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "daterange": {
      "description": "履历里显示的日期跨度，如 2019.09 – 2021.09；只写年月也行。",
      "type": "string",
      "minLength": 1
    },
    "period": { "$ref": "#/definitions/period" },
    "permalink": { "type": "string", "pattern": "^/portfolio/[a-z0-9][a-z0-9-]*/?$" }
  },
  "definitions": {
    "period": {
      "description": "履历分期：phd 博士 / gap 过渡期 / master 硕士 / bachelor 本科。",
      "type": "string",
      "enum": ["phd", "gap", "master", "bachelor"]
    }
  }
}
