{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "awards.schema.json",
  "title": "获奖与荣誉数据",
  "description": "_data/awards.yml —— /timeline/、首页「获奖」「荣誉」与履历时间轴的唯一数据源。按年份倒序；key: honours 那一组是荣誉（不参与分期）。",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/definitions/group" },
  "definitions": {
    "period": {
      "type": "string",
      "enum": ["phd", "gap", "master", "bachelor"]
    },
    "level": {
      "description": "等级标签，决定颜色与文字；填别的值会没有标签（不影响构建）。文字取自 _data/ui-text.yml 的 award_level_*。",
      "type": "string",
      "enum": ["international", "national", "provincial", "school", "other"]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "items"],
      "properties": {
        "year": { "type": "string", "minLength": 1 },
        "year_en": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "enum": ["honours"] },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/item" }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "text_en"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "text_en": { "type": "string", "minLength": 1 },
        "level": { "$ref": "#/definitions/level" },
        "period": { "$ref": "#/definitions/period" },
        "note": { "type": "string" },
        "note_en": { "type": "string" },
        "date": { "type": "string" },
        "date_en": { "type": "string" }
      }
    }
  }
}
